[submodule "firmware/stm32/Drivers/CMSIS/Core_repo"]
	path = firmware/stm32/Drivers/CMSIS/Core_repo
	url = https://github.com/STMicroelectronics/cmsis_core
[submodule "firmware/stm32/Drivers/CMSIS/Device/ST/STM32H7xx"]
	path = firmware/stm32/Drivers/CMSIS/Device/ST/STM32H7xx
	url = https://github.com/STMicroelectronics/cmsis_device_h7
[submodule "firmware/stm32/Drivers/STM32H7xx_HAL_Driver"]
	path = firmware/stm32/Drivers/STM32H7xx_HAL_Driver
	url = https://github.com/STMicroelectronics/stm32h7xx_hal_driver
[submodule "ui/lvgl/lvgl"]
	path = ui/lvgl/lvgl
	url = https://github.com/lvgl/lvgl
